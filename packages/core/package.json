{
  "name": "@nekora-ai/core",
  "version": "1.0.2",
  "description": "TypeScript-first, provider-agnostic AI Agent SDK built from scratch for reliable autonomous agents",
  "author": "Nekora AI Team <hello@nekora.ai>",
  "license": "MIT",
  "homepage": "https://github.com/Swati-a11/NekoraSDK#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Swati-a11/NekoraSDK.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Swati-a11/NekoraSDK/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "default": "./dist/providers/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js",
      "default": "./dist/memory/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "default": "./dist/tools/index.js"
    },
    "./guardrails": {
      "types": "./dist/guardrails/index.d.ts",
      "import": "./dist/guardrails/index.js",
      "default": "./dist/guardrails/index.js"
    },
    "./handoff": {
      "types": "./dist/handoff/index.d.ts",
      "import": "./dist/handoff/index.js",
      "default": "./dist/handoff/index.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "import": "./dist/sandbox/index.js",
      "default": "./dist/sandbox/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "agent",
    "sdk",
    "typescript",
    "openai",
    "gemini",
    "claude",
    "groq",
    "autonomous-agents",
    "llm",
    "cognitive-memory",
    "guardrails"
  ],
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
